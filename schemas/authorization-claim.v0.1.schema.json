{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ciaf-lcm.org/v0.1/authorization-claim.v0.1.schema.json",
  "title": "CIAF-LCM AuthorizationClaim v0.1",
  "description": "Cryptographically signed pre-execution authorization decision emitted by a Pre-Execution Governance Gateway (CIAF-06, CIAF-07, CIAF-12). Licensed under Apache-2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_type",
    "claim_id",
    "sequence_number",
    "previous_receipt_digest",
    "timestamp",
    "gateway_id",
    "subject",
    "authority_context",
    "proposed_action",
    "decision",
    "human_escalation",
    "execution_grant",
    "signature",
    "claim_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "claim_type": {
      "const": "AUTHORIZATION_CLAIM"
    },
    "claim_id": {
      "type": "string",
      "minLength": 8
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 0
    },
    "previous_receipt_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256_digest" }
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "description": "Gateway-asserted ISO-8601 UTC evaluation timestamp. Offline TTL verification checks chronological consistency across issuer-asserted clocks; defending against colluding clock backdating requires an external RFC 3161 TSA token or IETF SCITT (RFC 9943 / RFC 9942) registration timestamp."
    },
    "gateway_id": {
      "type": "string",
      "minLength": 3
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "use_case_id",
        "business_purpose",
        "accountable_owner"
      ],
      "properties": {
        "agent_id": { "type": "string", "minLength": 3 },
        "use_case_id": { "type": "string", "minLength": 3 },
        "business_purpose": { "type": "string", "minLength": 5 },
        "accountable_owner": { "type": "string", "minLength": 3 }
      }
    },
    "authority_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_id",
        "authority_status",
        "policy_id",
        "policy_version",
        "policy_digest",
        "delegated_scope_snapshot"
      ],
      "properties": {
        "delegation_id": { "type": "string", "minLength": 3 },
        "authority_status": {
          "type": "string",
          "enum": ["ACTIVE", "REVOKED", "SUSPENDED"]
        },
        "policy_id": { "type": "string", "minLength": 3 },
        "policy_version": { "type": "string", "minLength": 1 },
        "policy_digest": { "$ref": "#/$defs/sha256_digest" },
        "delegated_scope_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "description": "Signed snapshot of standing delegated scope enabling stateless verifiers (CIAF-10) to independently verify tool, owner, revocation, and minor-unit monetary limits without trusting Gateway assertions blindly.",
          "required": [
            "accountable_owner",
            "allowed_tools",
            "max_auto_amount_minor_units",
            "escalation_max_amount_minor_units",
            "currency",
            "revoked"
          ],
          "properties": {
            "accountable_owner": { "type": "string", "minLength": 3 },
            "allowed_tools": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            },
            "max_auto_amount_minor_units": {
              "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
            },
            "escalation_max_amount_minor_units": {
              "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
            },
            "currency": {
              "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 3 }]
            },
            "revoked": { "type": "boolean" }
          }
        }
      }
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "tool_name",
        "operation",
        "parameters",
        "request_digest"
      ],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 4 },
        "tool_name": { "type": "string", "minLength": 2 },
        "operation": { "type": "string", "minLength": 2 },
        "parameters": {
          "type": "object",
          "description": "Canonical action parameters. Monetary operations MUST encode exact ISO-4217 integer minor units (`amount_minor_units`, `currency`, `minor_unit_scale`), never IEEE-754 floats."
        },
        "request_digest": { "$ref": "#/$defs/sha256_digest" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_code",
        "rationale",
        "evaluated_controls"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["ALLOW", "DENY", "ESCALATE", "INSPECT"]
        },
        "reason_code": { "type": "string", "minLength": 3 },
        "rationale": { "type": "string", "minLength": 5 },
        "evaluated_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^CIAF-(0[1-9]|1[0-2])$"
          }
        }
      }
    },
    "human_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer_id",
        "review_rationale",
        "reviewed_at"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"]
        },
        "reviewer_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 3 }]
        },
        "review_rationale": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 5 }]
        },
        "reviewed_at": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 20 }]
        },
        "reviewer_signature": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ed25519_signature" }]
        }
      }
    },
    "execution_grant": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grant_id",
            "nonce",
            "issued_at",
            "expires_at",
            "ttl_seconds",
            "target_service",
            "bound_agent_id",
            "bound_tool_name",
            "bound_request_digest",
            "bound_policy_digest",
            "bound_authorization_claim_id",
            "gateway_grant_signature"
          ],
          "properties": {
            "grant_id": { "type": "string", "minLength": 6 },
            "nonce": { "type": "string", "minLength": 16 },
            "issued_at": { "type": "string", "minLength": 20 },
            "expires_at": { "type": "string", "minLength": 20 },
            "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
            "target_service": { "type": "string", "minLength": 3 },
            "bound_agent_id": { "type": "string", "minLength": 3 },
            "bound_tool_name": { "type": "string", "minLength": 2 },
            "bound_request_digest": { "$ref": "#/$defs/sha256_digest" },
            "bound_policy_digest": { "$ref": "#/$defs/sha256_digest" },
            "bound_authorization_claim_id": { "type": "string", "minLength": 8 },
            "gateway_grant_signature": { "$ref": "#/$defs/ed25519_signature" }
          }
        }
      ]
    },
    "signature": { "$ref": "#/$defs/ed25519_signature" },
    "claim_digest": { "$ref": "#/$defs/sha256_digest" }
  },
  "$defs": {
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ed25519_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "key_id",
        "signed_payload_digest",
        "sig_b64u"
      ],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "key_id": { "type": "string", "minLength": 3 },
        "signed_payload_digest": { "$ref": "#/$defs/sha256_digest" },
        "sig_b64u": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}

